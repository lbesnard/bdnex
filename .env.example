# Copy to .env (never commit it).
COMICS_DIR=/path/to/your/comics
BDNEX_PASSWORD=change-me
BDNEX_USER=bdnex
PUID=1000
PGID=1000
# BDNEX_PORT=8765
# BDNEX_VERSION=latest          # or a release (0.13.0) to stay on it: `docker compose pull` then `up -d`
# CONFIG_DIR=./config
# DATA_DIR=./data
# COVERS_DIR=/path/for/covers
